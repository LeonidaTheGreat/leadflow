# AI Lead Response System - Environment Configuration
# Copy this file to .env.local and fill in your values

# ============================================
# Database API (Required)
# ============================================
NEXT_PUBLIC_API_URL=https://your-api-server.example.com
NEXT_PUBLIC_API_KEY=your-api-key
API_SECRET_KEY=your-secret-key

# ============================================
# Stripe Billing (Required for paid plans)
# ============================================
# Get secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Webhook secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from https://dashboard.stripe.com/products
# Must be real Stripe price IDs (format: price_XXXXXXXXXXXXXX), NOT placeholder strings
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_ANNUAL=price_...

# ============================================
# Anthropic / Claude AI (Required)
# ============================================
ANTHROPIC_API_KEY=your-anthropic-api-key

# ============================================
# Twilio (Required for SMS)
# ============================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER_US=+1XXXXXXXXXX
TWILIO_PHONE_NUMBER_CA=+1XXXXXXXXXX
# Set to true for testing without sending real SMS
TWILIO_MOCK_MODE=false

# ============================================
# Follow Up Boss (Required for CRM sync)
# ============================================
FUB_API_KEY=your-fub-api-key
FUB_WEBHOOK_SECRET=your-fub-webhook-secret
FUB_API_BASE_URL=https://api.followupboss.com/v1

# ============================================
# Cal.com (Required for booking)
# ============================================
CALCOM_API_KEY=your-calcom-api-key
CALCOM_EVENT_TYPE_ID=your-event-type-id
CALCOM_BASE_URL=https://api.cal.com/v1
NEXT_PUBLIC_CALCOM_URL=https://cal.com
NEXT_PUBLIC_DEMO_BOOKING_URL=https://cal.com/stojan/15min

# ============================================
# Resend (Required for email delivery)
# ============================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
# Email address to send from (domain must be verified in Resend)
FROM_EMAIL=stojan@landyourleads.com

# ============================================
# Application
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================
# Optional: Analytics & Monitoring
# ============================================
# SENTRY_DSN=your-sentry-dsn
# POSTHOG_KEY=your-posthog-key

# ============================================
# PostHog Analytics (Optional)
# ============================================
# Get your project API key from: https://app.posthog.com/project/settings
# NEXT_PUBLIC_POSTHOG_KEY=posthog_key_here
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# Google Analytics 4 (Optional)
# ============================================
# Set this to your GA4 measurement ID to enable GA4 tracking.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
