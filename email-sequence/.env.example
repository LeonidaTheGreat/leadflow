# Resend API Configuration
# Get your API key from: https://resend.com/api-keys

RESEND_API_KEY=re_your_api_key_here
RESEND_AUDIENCE_ID=leadflow-pilot

# Test Mode (set to 'true' to send to test addresses only)
TEST_MODE=true

# From Address (must be verified in Resend)
FROM_EMAIL=pilot@landyourleads.com
FROM_NAME=LeadFlow Pilot Team

# Reply-To Address
REPLY_TO=support@landyourleads.com

# Application URLs
APP_URL=https://app.landyourleads.com
API_URL=https://api.landyourleads.com

# Test Recipients (comma-separated)
TEST_RECIPIENTS=test-agent-1@landyourleads.com,test-agent-2@landyourleads.com,test-agent-3@landyourleads.com
