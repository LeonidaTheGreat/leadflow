{
  "name": "fub-ai-lead-response",
  "version": "1.0.0",
  "description": "FUB Webhook Integration - Receives FUB events and triggers AI SMS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node integration/test-e2e-flow.js",
    "test:twilio": "node test/twilio-sms-integration.test.js",
    "test:twilio:live": "SKIP_LIVE_TESTS=false node test/twilio-sms-integration.test.js",
    "test:stripe-smoke": "node tests/integrated/stripe-production-smoke.test.js",
    "test:stripe-smoke:local": "LOCAL_MODE=true node tests/integrated/stripe-production-smoke.test.js",
    "test:load": "node scripts/load-test.js",
    "test:load:quick": "node scripts/load-test.js --quick",
    "test:load:local": "node scripts/load-test.js --target local",
    "test:browser": "npx playwright test --config=playwright.config.js",
    "test:browser:headed": "npx playwright test --config=playwright.config.js --headed",
    "test:browser:local": "PLAYWRIGHT_BASE_URL=http://localhost:3000 npx playwright test --config=playwright.config.js"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "cron": "^3.1.6",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "node-schedule": "^2.1.1",
    "pg": "^8.19.0",
    "twilio": "^4.19.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "dotenv": "^17.3.1",
    "nodemon": "^3.0.2"
  }
}
