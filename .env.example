# LeadFlow AI — Environment Variables
# Copy to .env and fill in real values

# ─── Database ────────────────────────────────────────────────────
LOCAL_PG_URL=postgresql://clawdbot@localhost/openclaw

# ─── PostgREST API (used by dashboard + smoke tests) ─────────────
NEXT_PUBLIC_API_URL=https://api.imagineapi.org
API_SECRET_KEY=your_api_secret_key
NEXT_PUBLIC_API_KEY=your_public_api_key

# ─── Stripe Billing ─────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create in Stripe Dashboard > Products > Prices
# Each must be a real Stripe price ID (format: price_XXXXXXXXXXXXXXXX)
# Dashboard: https://dashboard.stripe.com/test/products
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_ANNUAL=price_...

# ─── Follow Up Boss CRM ─────────────────────────────────────────
FUB_API_KEY=your_fub_api_key

# ─── Twilio SMS ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER_US=+1XXXXXXXXXX
TWILIO_PHONE_NUMBER_CA=+1XXXXXXXXXX

# ─── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── LeadFlow API ───────────────────────────────────────────────
LEADFLOW_API_KEY=your_leadflow_api_key

# ─── App URLs ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://leadflow-ai-five.vercel.app
