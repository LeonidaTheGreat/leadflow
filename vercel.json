{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "main": false,
      "preview": false
    }
  },
  "ignoreCommand": "[ \"$VERCEL_PROJECT_ID\" = \"prj_p9ZX952UhE1cl1PYZAgVW53FqVm9\" ] && exit 0 || exit 1",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-performance",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/check-stuck-pilots",
      "schedule": "0 8 * * *"
    }
  ]
}
