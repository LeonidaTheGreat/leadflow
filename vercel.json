{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-performance",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/check-stuck-pilots",
      "schedule": "0 8 * * *"
    }
  ]
}
